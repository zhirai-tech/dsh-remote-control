{
  "name": "dsh-remote-control",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Remote control for DeepSeek Harness: LAN or public QR pairing, desktop takeover mask, unlock codes, one-tap PC lock, phone file explorer.",
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "bin",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhirai-tech/dsh-remote-control.git"
  },
  "homepage": "https://github.com/zhirai-tech/dsh-remote-control#readme"
}
