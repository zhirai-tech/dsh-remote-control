{
  "name": "dsh-remote-control",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "LAN remote control for DeepSeek Harness: pairing, desktop mask, unlock codes, one-tap PC lock and a phone file explorer.",
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhirai-tech/dsh-remote-control.git"
  },
  "homepage": "https://github.com/zhirai-tech/dsh-remote-control#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-control",
    "lan",
    "mobile"
  ]
}
